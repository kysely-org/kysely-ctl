{
	"name": "kysely-ctl",
	"version": "0.21.0",
	"type": "module",
	"bin": {
		"kysely": "./dist/bin.mjs"
	},
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"assets"
	],
	"description": "Command-line tool for Kysely",
	"author": "Igal Klebanov <igalklebanov@gmail.com> (https://github.com/igalklebanov)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kysely-org/kysely-ctl.git"
	},
	"homepage": "https://kysely.dev",
	"scripts": {
		"biome": "biome",
		"build": "tsdown",
		"prepublishOnly": "biome check && pnpm build",
		"start": "pnpm build --watch",
		"test": "vitest"
	},
	"dependencies": {
		"c12": "^3.3.4",
		"citty": "^0.2.2",
		"confbox": "^0.3.1",
		"consola": "^3.4.2",
		"jiti": "^2.7.0",
		"nypm": "^0.6.10",
		"ofetch": "^1.5.1",
		"pathe": "^2.0.3",
		"pkg-types": "^2.3.3",
		"std-env": "^4.3.0"
	},
	"peerDependencies": {
		"kysely": ">=0.18.1 <0.30.0",
		"kysely-neon": "^2 || ^3",
		"kysely-postgres-js": "^2 || ^3 || ^4 || ^5",
		"kysely-prisma-postgres": "^0.1"
	},
	"peerDependenciesMeta": {
		"kysely-neon": {
			"optional": true
		},
		"kysely-postgres-js": {
			"optional": true
		},
		"kysely-prisma-postgres": {
			"optional": true
		}
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@arktype/attest": "0.57.0",
		"@biomejs/biome": "2.5.15",
		"@tsconfig/node24": "24.0.5",
		"@types/better-sqlite3": "catalog:",
		"@types/node": "26.6.5",
		"better-sqlite3": "catalog:",
		"kysely": "catalog:",
		"kysely-neon": "3.0.0",
		"kysely-postgres-js": "5.0.1",
		"kysely-prisma-postgres": "0.1.0",
		"postgres": "3.4.9",
		"publint": "0.3.25",
		"tsdown": "0.23.1",
		"type-fest": "5.10.0",
		"typescript": "catalog:",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"cli",
		"ctl",
		"kysely",
		"migration",
		"seeding",
		"codegen"
	],
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"inlinedDependencies": {
		"type-fest": "5.10.0"
	}
}
